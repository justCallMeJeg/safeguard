generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id String @id // Discord Guild ID

  // Feature toggles
  antinukeEnabled Boolean @default(false) @map("antinuke_enabled")
  loggingEnabled  Boolean @default(true) @map("logging_enabled")
  welcomeEnabled  Boolean @default(false) @map("welcome_enabled")

  // Logging channels
  logsChannel       String? @map("logs_channel")
  modLogsChannel    String? @map("mod_logs_channel")
  memberLogsChannel String? @map("member_logs_channel")

  // Roles
  mutedRole String? @map("muted_role")
  modRole   String? @map("mod_role")
  adminRole String? @map("admin_role")

  // Antinuke whitelist (user/role IDs exempt from checks)
  whitelist String[] @default([])

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  auditLogs AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  guildId   String   @map("guild_id")
  action    String
  executor  String
  targetId  String?  @map("target_id")
  reason    String?
  metadata  Json?
  timestamp DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, timestamp])
  @@index([executor])
}
