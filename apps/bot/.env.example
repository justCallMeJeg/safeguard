# ===========================================
# Safeguard Bot Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Sensitive values should ONLY be in .env, never in config.json

# ---- Required: Bot Credentials ----
BOT_TOKEN=your_bot_token
CLIENT_ID=your_client_id
PUBLIC_KEY=your_public_key
CLIENT_SECRET=your_client_secret

# ---- Bot Configuration ----
# Comma-separated list of Discord user IDs who can use owner-only commands
BOT_OWNER_IDS=123456789012345678,987654321098765432

# Development guild ID for instant command updates (optional)
DEV_GUILD_ID=your_dev_guild_id

# ---- Settings (Optional - defaults in config.json) ----
# BOT_PREFIX=!
# COOLDOWN_DEFAULT_MS=3000
# COOLDOWN_BYPASS_ROLES=
# COOLDOWN_BYPASS_USERS=

# ---- Features (Optional) ----
# HOT_RELOAD=true
# DEBUG_MODE=false
# VERBOSE_EVENTS=false
# AUTO_DEPLOY_DEV=true

# ---- Logging (Optional) ----
# LOG_LEVEL=info
# LOG_TIMESTAMPS=true
# LOG_COLORS=true
# LOG_COMPACT=false
